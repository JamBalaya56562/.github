# OpenTofu / Terraform
# .terraform.lock.hcl is committed for provider version pinning.
.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
crash.log
crash.*.log

# This module is operated exclusively via GitHub Actions and all input
# values live in variables.tf defaults; tfvars files are not used in CI,
# so any *.tfvars in this directory is by definition a local artifact
# and must not be committed.
*.tfvars
*.tfvars.json

# Plan outputs
*.tfplan
tfplan

# OS
.DS_Store
Thumbs.db
